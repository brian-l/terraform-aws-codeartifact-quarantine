# ─── Terraform ─────────────────────────────────────────────────────────────

# Local .terraform directories
.terraform/

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# .tfvars files (sensitive — never check in)
*.tfvars
*.tfvars.json

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Transient lock info files created by terraform apply
.terraform.tfstate.lock.info

# CLI configuration files
.terraformrc
terraform.rc

# Lock files for *modules* (this repo).
# Convention: root Terraform configurations COMMIT .terraform.lock.hcl so deploys
# are reproducible. Reusable modules (like this one) DO NOT commit them so
# consumers can pick their own provider versions. We are a module, so we ignore.
.terraform.lock.hcl

# Saved plan output
*.tfplan
*.tfplan.*

# ─── Module build artifacts ────────────────────────────────────────────────

# archive_file output dir used by the pipeline submodule's Lambda packager
modules/*/.terraform.tmp/

# archive_file in modules/pipeline/lambdas.tf reads lambda/common/ directly
# via explicit source blocks; no copies are made in handler subdirs anymore.
# Kept here as a safety net in case anyone resurrects the old `make` approach.
lambda/*/common/

# ─── Python ────────────────────────────────────────────────────────────────

__pycache__/
*.py[cod]
*$py.class

# Tool caches
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
.coverage.*
htmlcov/

# Build / dist (no Python packaging here today, but defensive)
*.egg-info/
build/
dist/

# Virtual environments
.venv/
venv/
env/

# ─── Terratest (Go) ───────────────────────────────────────────────────────

test/*.test
test/vendor/

# ─── Pre-commit ────────────────────────────────────────────────────────────

# pre-commit stores hook environments under ~/.cache/pre-commit, not the repo.
# No project-local artifacts to ignore.

# ─── IDE / editor / OS ─────────────────────────────────────────────────────

# JetBrains
.idea/
*.iml

# VS Code (allow shared settings, ignore personal)
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json

# Vim
*.swp
*.swo
*~

# macOS
.DS_Store

# Windows
Thumbs.db
desktop.ini

# ─── Misc ──────────────────────────────────────────────────────────────────

# Local scratch / notes (uncomment if you want a per-clone notes dir)
# .scratch/
# NOTES.local.md
